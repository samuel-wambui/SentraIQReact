            "rawQuery": true,
            "rawSql": "WITH raw_messages AS (\n  SELECT m.created_at, c.source\n  FROM conversation_messages m\n  LEFT JOIN conversations c ON c.id = m.conversation_id\n\n  UNION ALL\n\n  SELECT cm.created_at, c.source\n  FROM conversation_continuation_messages cm\n  LEFT JOIN conversations c ON c.id = cm.conversation_id\n), message_channels AS (\n  SELECT\n    (created_at AT TIME ZONE 'Africa/Nairobi') AS created_at,\n    CASE\n      WHEN source_map.source_key LIKE '%whatsapp%' THEN 'WhatsApp'\n      WHEN source_map.source_key IN ('facebook', 'fb', 'messenger')\n        OR source_map.source_key LIKE '%facebook%'\n        OR source_map.source_key LIKE '%messenger%' THEN 'Facebook'\n      WHEN source_map.source_key IN ('x', 'xcom', 'twitter')\n        OR source_map.source_key LIKE '%twitter%' THEN 'X'\n      WHEN source_map.source_key IN ('instagram', 'ig')\n        OR source_map.source_key LIKE '%instagram%' THEN 'Instagram'\n      ELSE coalesce(nullif(trim(source), ''), 'Unknown')\n    END AS channel\n  FROM raw_messages\n  CROSS JOIN LATERAL (\n    SELECT regexp_replace(lower(coalesce(source, '')), '[^a-z0-9]', '', 'g') AS source_key\n  ) source_map\n), bucketed_messages AS (\n  SELECT\n    $__timeGroupAlias(created_at, $__interval),\n    channel,\n    count(*) AS value\n  FROM message_channels\n  WHERE $__timeFilter(created_at)\n  GROUP BY 1, 2\n)\nSELECT\n  time,\n  channel AS metric,\n  sum(value) OVER (PARTITION BY channel ORDER BY time) AS value\nFROM bucketed_messages\nORDER BY time;",
